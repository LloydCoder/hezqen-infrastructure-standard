{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hezqen.com/schemas/product-manifest.schema.json",
  "title": "HEZQEN Product Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "license",
    "description",
    "runtime"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "networkRequired"
      ],
      "properties": {
        "networkRequired": {
          "type": "boolean"
        },
        "supportedPlatforms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "containerized": {
          "type": "boolean"
        }
      }
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^\\\\s]+$"
    },
    "documentation": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^\\\\s]+$"
    },
    "support": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^\\\\s]+$"
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://[^\\\\s]+$"
          }
        }
      }
    }
  }
}
