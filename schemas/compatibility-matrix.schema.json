{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hezqen.com/schemas/compatibility-matrix.schema.json",
  "title": "HEZQEN Compatibility Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product",
    "version",
    "records"
  ],
  "properties": {
    "product": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "compatibility.schema.json"
      }
    }
  }
}
