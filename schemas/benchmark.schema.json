{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hezqen.com/schemas/benchmark.schema.json",
  "title": "HEZQEN Benchmark Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark",
    "recordedAt",
    "sourceRevision",
    "environment",
    "metrics"
  ],
  "properties": {
    "benchmark": {
      "type": "string",
      "minLength": 1
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 7
    },
    "environment": {
      "type": "object",
      "additionalProperties": true
    },
    "workload": {
      "type": "object",
      "additionalProperties": true
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
