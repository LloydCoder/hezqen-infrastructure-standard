{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hezqen.com/schemas/artifact-manifest.schema.json",
  "title": "HEZQEN Release Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product",
    "version",
    "sourceRevision",
    "artifacts"
  ],
  "properties": {
    "product": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 7
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256",
          "mediaType"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "signature": {
            "type": "string",
            "format": "uri"
          },
          "sbom": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
