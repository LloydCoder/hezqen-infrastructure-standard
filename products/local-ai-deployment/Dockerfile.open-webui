ARG BASE_IMAGE=ghcr.io/open-webui/open-webui@sha256:ea9fee9b0d83a4d73f5ddb7e23ccf42bc3514aaebc7382247af1287871397140
FROM ${BASE_IMAGE}

USER 0:0
RUN addgroup --gid 10001 app \
    && adduser --uid 10001 --gid 10001 --home /tmp --disabled-password --no-create-home --gecos "" app \
    && mkdir -p /app/backend/data /tmp/.cache \
    && chown -R 10001:10001 /app/backend/data /tmp/.cache

ENV HOME=/tmp
ENV XDG_CACHE_HOME=/tmp/.cache
ENV TMPDIR=/tmp
USER 10001:10001
