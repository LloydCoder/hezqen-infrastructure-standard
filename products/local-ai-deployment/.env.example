# Copy to .env and set a unique secret before startup.
# Keep .env out of version control and chmod 600 .env.
OLLAMA_IMAGE=ollama/ollama:0.40.16
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.13.2
WEBUI_BIND_ADDRESS=127.0.0.1
WEBUI_PORT=3000
WEBUI_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
OLLAMA_MEMORY_LIMIT=16g
OLLAMA_CPUS=8.0
WEBUI_MEMORY_LIMIT=2g
WEBUI_CPUS=2.0
